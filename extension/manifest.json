{
  "manifest_version": 3,
  "name": "Bili IP Lens · B站评论 IP 属地",
  "version": "0.1.1",
  "description": "在 B站评论旁显示平台已有的 IP 属地。工具栏一键开关，即时生效。",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "action": {
    "default_title": "Bili IP Lens · 显示 IP 属地",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/*", "https://t.bilibili.com/*", "https://space.bilibili.com/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.bilibili.com/*", "https://t.bilibili.com/*", "https://space.bilibili.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
